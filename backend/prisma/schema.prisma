// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Aluno {
  id String @id @default(uuid())
  nome String
  email String @unique
  ra String @unique
  periodo String
  curso String? // Criar Tabela de Curso depois?
  avatar String?
  semestre String
  senha String

  matriculas Matricula[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Disciplina {
  id String @id @default(uuid())
  codigo String @unique
  nome String
  descricao String?
  professor String?
  creditos Int
  vagas Int
  departamento String?
  periodoIdeal Int?
  
  preRequisitoId String?
  preRequisito Disciplina? @relation("PreRequisito", fields: [preRequisitoId], references: [id])
  dependentes Disciplina[] @relation("PreRequisito")
  
  horarios Horario[]

  matriculas Matricula[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Matricula {
  id String @id @default(uuid())
  alunoId String
  aluno Aluno @relation(fields: [alunoId], references: [id])

  disciplinaID String
  disciplina Disciplina @relation(fields: [disciplinaID], references: [id])

  status String // "inscrito", "aprovado", "reprovado", etc

  ano Int
  semestre Int 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique ([alunoId, disciplinaID, semestre, ano]) // Um aluno só pode se matricular uma vez em uma disciplina
}

model Admin {
  id    String @id @default(uuid())
  nome  String
  email String @unique
  senha String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Horario {
  id String @id @default(uuid())
  diaSemana String
  horarioInicio String
  horarioFim String

  disciplinaId String
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
}

model Config {
  id String @id @default(uuid())
  chave String @unique
  valor String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
